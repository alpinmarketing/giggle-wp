{
    "name": "alpinmarketing/giggle-wp",
    "description": "Display Giggle.tips experiences and events on your WordPress site using a Gutenberg block.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wordpress-stubs": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "AM\\GiggleWp\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
