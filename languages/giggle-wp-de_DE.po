#. Plugin Name of the plugin
#: giggle-wp.php includes/Settings.php:33
msgid "Giggle WP"
msgstr "Giggle WP"

#. Plugin URI of the plugin
#: giggle-wp.php
msgid "https://www.alpinmarketing.at/wordpress-agentur-hotel-webdesign-tirol/"
msgstr ""

#. Description of the plugin
#: giggle-wp.php
msgid ""
"Display Giggle.tips experiences and events on your WordPress site using a "
"Gutenberg block. Supports schema.org JSON-LD semantic annotations."
msgstr ""
"Zeigen Sie Giggle.tips-Erfahrungen und -Veranstaltungen auf Ihrer WordPress-"
"Seite mit einem Gutenberg-Block an. Unterstützt schema.org JSON-LD "
"semantische Annotationen."

#. Author of the plugin
#: giggle-wp.php
msgid "ALPINMARKETING®"
msgstr ""

#. Author URI of the plugin
#: giggle-wp.php
msgid "https://www.alpinmarketing.at"
msgstr ""

