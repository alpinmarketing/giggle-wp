msgstr "Stream Kongfiguration"

#: assets/js/giggle-block-editor.js:83
msgid "Stream ID(s)"
msgstr "Stream-ID(s)"

#: assets/js/giggle-block-editor.js:84
msgid ""
"Comma-separated stream UUIDs from the Giggle CMS. At least one is required."
msgstr ""
"Kommagetrennte Stream-UUIDs vom Giggle-CMS. Mindestens eine ist "
"erforderlich."

#: assets/js/giggle-block-editor.js:90
msgid "Language"
msgstr "Sprache"

#: assets/js/giggle-block-editor.js:91
msgid ""
"ISO language code for translations. Leave empty to return all languages."
msgstr ""
"ISO-Sprachcode für Übersetzungen. Lassen Sie alle Sprachen leer, um sie "
"zurückzugeben."

#: assets/js/giggle-block-editor.js:97
msgid "Bookable experiences only"
msgstr "Nur buchbare Erlebnisse"

#: assets/js/giggle-block-editor.js:98
msgid "When enabled, only experiences that can be booked are shown."
msgstr ""
"Wenn aktiviert, werden nur Erlebnisse angezeigt, die gebucht werden können."

#: assets/js/giggle-block-editor.js:106
msgid "Date & Pagination"
msgstr "Datum & Paginierung"

#: assets/js/giggle-block-editor.js:110
msgid "Date Range"
msgstr "Datumsbereich"

#: assets/js/giggle-block-editor.js:111
msgid ""
"ISO 8601 date range: 2026-06-01T00:00:00.000Z|2026-06-30T23:59:59.999Z. "
"Leave empty for all dates."
msgstr ""
"ISO 8601 Datumsbereich: 2026-06-01T00:00:00.000Z|2026-06-30T23:59:59.999Z. "
"Lass die Karten für alle Daten leer."

#: assets/js/giggle-block-editor.js:117
msgid "Items per page"
msgstr "Artikel pro Seite"

#: assets/js/giggle-block-editor.js:118
msgid "Maximum number of experiences to display (1–50)."
msgstr "Maximale Anzahl an Erlebnissen anzuzeigen (1–50)."

#: assets/js/giggle-block-editor.js:128
msgid "Display"
msgstr "Anzeige"

#: assets/js/giggle-block-editor.js:132
msgid "Section title"
msgstr "Bereichstitel"

#: assets/js/giggle-block-editor.js:133
msgid "Optional heading shown above the event list."
msgstr "Optionale Überschrift über der Veranstaltungsliste."

#: assets/js/giggle-block-editor.js:138
